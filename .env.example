# Set the real canonical domain before deploying publicly. Never use a preview URL.
# Blank keeps pages noindex and omits canonical/share URLs and sitemap entries.
# Rebuild after changing any NEXT_PUBLIC_* setting.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GITHUB_URL=
# Server-only Control Center webhook; requires the v1 JSON acceptance receipt.
# Local development: http://localhost:4000/api/integrations/website/leads
# Production: https://YOUR_CONTROL_HOST/api/integrations/website/leads
# Token: identical to Control Center WEBSITE_LEAD_WEBHOOK_TOKEN, >=32 random characters.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Optional: Control Center project's Protection Bypass for Automation secret.
# Required only when Vercel Deployment Protection covers the webhook URL.
# Server-only and separate from LEAD_WEBHOOK_TOKEN.
LEAD_WEBHOOK_VERCEL_BYPASS_SECRET=
# Optional Cloudflare Turnstile. Configure BOTH keys to enable spam protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_VERCEL_ANALYTICS=false
GOOGLE_SITE_VERIFICATION=
