# Set the real canonical domain before deploying publicly. Never use a preview URL.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GITHUB_URL=
# Server-only HTTPS webhook: responds 2xx only after accepting the request.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Optional Cloudflare Turnstile. Configure BOTH keys to enable spam protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_VERCEL_ANALYTICS=false
GOOGLE_SITE_VERIFICATION=
